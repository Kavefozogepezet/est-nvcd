
ecut 46
kptopt  1
ngkpt   3*6
shiftk  3*0

# def of supercell
acell 3*6.7512815770
cellcharge -1
rprim
    1 0 0
    0 1 0
    0 0 1

# info on possible atoms
ntypat  2
znucl   6 7
pp_dirpath  "$ABI_PPDIR"
pseudos     "C.psp8, N.psp8"

# atoms and positions
natom 7
typat 2 6*1
xcart
    0.0 0.0 0.0
    3.37563424945 3.37563424945 0.0
    5.0634513741500005 5.0634513741500005 1.6878171247
    0.0 3.37563424945 3.37563424945
    1.6878171247 5.0634513741500005 5.0634513741500005
    3.37563424945 0.0 3.37563424945
    5.0634513741500005 1.6878171247 5.0634513741500005

#scf
nstep   30
toldff  5.0d-4

# settings, hints
prtden  1
chksymbreak     0
chkprim 0
diemac  5.7
iomode  3
prtwf   1
istwfk  *1

# output directories
outdata_prefix  "./abinit-out/"
tmpdata_prefix  "./abinit-tmp/"

