# converged ecut and k grid
ecut    46

# def of primitive cell
acell   3*6.7512815770
rprim   1/2     1/2     0
        0       1/2     1/2
        1/2     0       1/2

# info on possible atoms
ntypat  1
znucl   6
pp_dirpath  "$ABI_PPDIR"
pseudos     "C.psp8"

# atoms and positions
natom   2
typat   1   1
xred    0       0       0
        1/4     1/4     1/4

# bands
iscf    -2
nband   8
#ndivsm  10
tolwfr  1.0d-12
enunit  1
kptopt  -11
ndivk   29 15 11 31 25 18 11 21 18 18 10
kptbounds
    +0.000000000  +0.000000000  +0.000000000  # $\Gamma$
    +0.500000000  +0.000000000  +0.500000000  # X
    +0.500000000  +0.250000000  +0.750000000  # W
    +0.375000000  +0.375000000  +0.750000000  # K
    +0.000000000  +0.000000000  +0.000000000  # $\Gamma$
    +0.500000000  +0.500000000  +0.500000000  # L
    +0.625000000  +0.250000000  +0.625000000  # U
    +0.500000000  +0.250000000  +0.750000000  # W
    +0.500000000  +0.500000000  +0.500000000  # L
    +0.375000000  +0.375000000  +0.750000000  # K
    +0.625000000  +0.250000000  +0.625000000  # U
    +0.500000000  +0.000000000  +0.500000000  # X

# settings, hints
getden_filepath "../scf-gs/abinit-out/_DEN.nc"
chksymbreak     0
nstep   30
diemac  5.7
iomode  3
prtwf   1
istwfk  *1

# output directories
outdata_prefix  "./abinit-out/"
tmpdata_prefix  "./abinit-tmp/"