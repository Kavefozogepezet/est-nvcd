
# loop over ecut
ndtset  9
ecut?:  37
ecut?+  2

# def of primitive cell
acell   3*6.74
rprim   1/2     1/2     0
        0       1/2     1/2
        1/2     0       1/2

# info on possible atoms
ntypat  1
znucl   6
pp_dirpath  "$ABI_PPDIR"
pseudos     "C.psp8"

# atoms and positions
natom   2
typat   1   1
xred    0       0       0
        1/4     1/4     1/4

# def of k grid
kptopt  1
ngkpt   3*15
shiftk  3*0


# settings, hints
chksymbreak     0
nstep   30
toldff  5.0d-4
diemac  5.7
getwfk -1

# output directories
outdata_prefix  "./abinit-out/"
tmpdata_prefix  "./abinit-tmp/"