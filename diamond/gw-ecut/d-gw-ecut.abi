ndtset  5

# converged ecut and k grid
ecut    46
kptopt  1
ngkpt   8       8       8
shiftk  0       0       0

# def of primitive cell
acell   3*6.7512684989
rprim   1/2     1/2     0
        0       1/2     1/2
        1/2     0       1/2

# info on possible atoms
ntypat  1
znucl   6
pp_dirpath  "$ABI_PPDIR"
pseudos     "C.psp8"

# atoms and positions
natom   2
typat   1   1
xred    0       0       0
        1/4     1/4     1/4

# self-energy
optdriver   4
nkptgw      1
kptgw       0       0       0
bdgw        4 5
nband       100
ecutsigx?:  4
ecutsigx?+  4

# settings, hints
getscr_filepath "../scr/abinit-out/_SCR.nc"
getwfk_filepath "../nscf-bands/abinit-out/_WFK.nc"
chksymbreak     0
nstep   30
diemac  5.7
iomode  3
prtwf   1
istwfk  *1

# output directories
outdata_prefix  "./abinit-out/"
tmpdata_prefix  "./abinit-tmp/"