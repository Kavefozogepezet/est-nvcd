ndtset  5

# converged ecut, single atom -> single k point
ecut    46
kptopt  0
nkpt    1

# def of primitive cell
acell?:     3*14
acell?+     3*2
rprim
    1 0 0
    0 1 0
    0 0 1

# info on possible atoms
ntypat  1
znucl   6
pp_dirpath  "$ABI_PPDIR"
pseudos     "C.psp8"

# atoms and positions
natom   1
typat   1
xred    3*0
nsppol  2          # Allow a spin-polarized calculation
occopt  0
nband   4 4
occ     1 1  1 0  1 0  0 0
spinat  0 0 2

# settings, hints
nstep   30
toldfe  1.0d-6
prtden  1
chksymbreak     0
iomode  3
prtwf   1
istwfk  *1

# output directories
outdata_prefix  "./abinit-out/"
tmpdata_prefix  "./abinit-tmp/"